# Nous GTM Prototype — Environment Variables
# Copy this file to .env and fill with your API tokens

# GitHub API token (for issue/search API access)
GITHUB_TOKEN=ghp_your_token_here

# HuggingFace API token (for model discussion search)
HF_TOKEN=hf_your_token_here

# Optional: Algolia app ID for Hacker News search
HN_ALGOLIA_APP_ID=

# Optional: Algolia API key
HN_ALGOLIA_API_KEY=

# Flask secret key (generate with: python3 -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change_this_to_a_random_string
